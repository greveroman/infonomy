---
import docs from '../../content/documents.json';

interface Props {
  doc: (typeof docs.items)[number];
  index: number;
  href?: string;
}
const { doc, index, href } = Astro.props;
const link = href ?? doc.url ?? null;
const Tag = link ? 'a' : 'div';

// «Архитектура живых систем: вопросы к …» → серия + название, как на обложке издания
const [series, rest] = doc.title.includes(':') ? doc.title.split(/:\s*/, 2) : ['', doc.title];
const title = rest.charAt(0).toUpperCase() + rest.slice(1);
const num = String(index + 1).padStart(2, '0');
---
<div id={doc.id}>
  <Tag href={link ?? undefined} class="cover">
    <div class="cover__in">
      <div class="contours" aria-hidden="true"></div>
      <div class="cover__top mono"><span>Документ № {num}</span><img src="/images/logo.png" alt="" width="564" height="96" /></div>
      {series && <div class="cover__series mono">{series}</div>}
      <h3 class="cover__title">{title}</h3>
      {link && <div class="cover__foot mono"><span>читать</span><span>→</span></div>}
    </div>
  </Tag>
  <div class="doc-desc">
    <div class="mono">{docs.descriptionLabel}</div>
    <p>{doc.description}</p>
    {!link && <p style="color:#b42318;">{docs.linkPlaceholder}</p>}
  </div>
</div>
