---
import docs from '../../content/documents.json';

interface Props {
  doc: (typeof docs.items)[number];
  index: number;
  href?: string;
}
const { doc, index, href } = Astro.props;
const link = href ?? doc.url ?? null;
const Tag = link ? 'a' : 'div';

// «Архитектура живых систем: вопросы к …» → серия + название
const [series, rest] = doc.title.includes(':') ? doc.title.split(/:\s*/, 2) : ['', doc.title];
const title = rest.charAt(0).toUpperCase() + rest.slice(1);
const num = String(index + 1).padStart(2, '0');
---
<div id={doc.id}>
  <Tag href={link ?? undefined} class="card">
    <div class="card__win" aria-hidden="true">
      <div class="strata"></div>
      <span class="card__num">Документ № {num}</span>
    </div>
    <div class="card__body">
      {series && <div class="card__series">{series}</div>}
      <h3 class="card__title">{title}</h3>
      {link && <div class="card__more">читать <span>→</span></div>}
    </div>
  </Tag>
  <div class="doc-desc">
    <div class="label">{docs.descriptionLabel}</div>
    <p>{doc.description}</p>
    {!link && <p style="color:#b42318;">{docs.linkPlaceholder}</p>}
  </div>
</div>
