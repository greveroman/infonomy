---
import join from '../content/join.json';

type Field = (typeof join.fields)[number];
const rows = [...new Set(join.fields.map((f) => f.row))].map((r) => join.fields.filter((f) => f.row === r));

const fld = "width:100%;border:none;border-bottom:2px solid #c9d1da;background:#f5f7f9;border-radius:6px 6px 0 0;padding:13px 12px;font-family:inherit;font-size:16px;color:#121821;outline:none;transition:border-color .4s cubic-bezier(.33,.72,.4,1),background .4s cubic-bezier(.33,.72,.4,1);";
const lbl = "font-family:Manrope,'Helvetica Neue',Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:#1e2530;";
const ease = (p: string) => `${p} .55s cubic-bezier(.33,.72,.4,1)`;
const id = (f: Field) => `f-${f.name}`;
---
<form id="join-form" action="/send.php" method="post" novalidate data-error={join.errorMessage} style="display:flex;flex-direction:column;gap:24px;">
  {rows.map((row) => {
    const cells = row.map((f) => (
      <div style="display:flex;flex-direction:column;gap:10px;">
        <label for={id(f)} style={lbl}>{f.label}{f.required && <span aria-hidden="true" style="color:#8b929b;"> *</span>}</label>
        {f.hint && <div id={`h-${f.name}`} style="font-size:13px;line-height:1.4;color:#69707a;margin-top:-4px;">{f.hint}</div>}
        {f.type === 'select' ? (
          <div style="position:relative;">
            <select id={id(f)} name={f.name} required={f.required} class="fld" style={`${fld}padding:13px 38px 13px 12px;appearance:none;cursor:pointer;`}>
              {f.options!.map((o) => <option value={o}>{o}</option>)}
            </select>
            <svg viewBox="0 0 20 20" width="13" height="13" aria-hidden="true" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);pointer-events:none;"><path d="M4 7.5 L10 13.5 L16 7.5" fill="none" stroke="#1e2530" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
        ) : f.type === 'textarea' ? (
          <textarea id={id(f)} name={f.name} rows="3" required={f.required} placeholder={f.placeholder} class="fld" style={`${fld}line-height:1.55;resize:vertical;`}></textarea>
        ) : (
          <input id={id(f)} name={f.name} type={f.type} required={f.required} placeholder={f.placeholder} autocomplete={f.autocomplete} aria-describedby={f.hint ? `h-${f.name}` : undefined} class="fld" style={fld} />
        )}
      </div>
    ));
    return row.length > 1
      ? <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:26px;">{cells}</div>
      : cells;
  })}

  <!-- Ловушка для спам-ботов: людям не видна -->
  <div style="position:absolute;left:-9999px;" aria-hidden="true">
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="hv-btn" style={`align-self:start;margin-top:6px;border:none;background:#1e2530;border-radius:8px;padding:15px 32px;font-family:Manrope,'Helvetica Neue',Arial,sans-serif;font-size:15px;font-weight:500;color:#fff;transition:${ease('background')},${ease('box-shadow')},${ease('transform')};`}>{join.submit}</button>
  <p id="join-error" role="alert" hidden style="font-size:15px;line-height:1.5;color:#b42318;"></p>
</form>

<div id="join-success" role="status" tabindex="-1" hidden style="border-radius:12px;background:#f3f5f8;box-shadow:inset 0 0 0 1px #e2e6ea;padding:24px 26px;font-weight:700;font-size:17px;line-height:1.5;color:#1e2530;outline:none;">
  {join.successMessage}
</div>

<script>
  const form = document.getElementById('join-form') as HTMLFormElement;
  const success = document.getElementById('join-success')!;
  const error = document.getElementById('join-error')!;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input, select, textarea')).filter((el) => el.name !== 'website');

  const check = (el: HTMLInputElement) => {
    el.value = el.value.trimStart();
    const ok = el.checkValidity();
    el.setAttribute('aria-invalid', String(!ok));
    return ok;
  };
  fields.forEach((el) => el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'blur', () => check(el)));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.hidden = true;
    const invalid = fields.filter((el) => !check(el));
    if (invalid.length) {
      invalid[0].focus();
      invalid[0].reportValidity(); // стандартная подсказка браузера на языке пользователя
      return;
    }
    button.disabled = true;
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) throw new Error(data.error || String(res.status));
      form.remove();
      success.hidden = false;
      success.focus();
    } catch {
      error.textContent = form.dataset.error ?? '';
      error.hidden = false;
      button.disabled = false;
    }
  });
</script>
