---
import AlmanacLayout from '../layouts/AlmanacLayout.astro';
import DocCover from '../components/almanac/DocCover.astro';
import home from '../content/home.json';
import docs from '../content/documents.json';
import site from '../content/site.json';
const { hero, initiative, research, participants } = home;
const last = hero.titleLines.length - 1;
// «… — это …»: вторую часть заголовка выделяем курсивом
const [initA, initB] = initiative.title.split(' — ');
---
<AlmanacLayout page="home">
  <section class="hero">
    <div class="contours" aria-hidden="true"></div>
    <div class="wrap">
      <div class="hero__meta mono"><span>{site.name}</span><span>{site.project}</span></div>
      <h1 class="display">
        {hero.titleLines.map((l, i) => <>{i > 0 && <br />}{i === last ? <em>{l}</em> : l}</>)}
      </h1>
      <div class="hero__grid">
        <div class="hero__text">
          <div class="sec-mark mono"><span>§ 01</span><span class="dot"></span><span class="line"></span></div>
          <h2 class="h2" style="margin-top:28px;">{hero.subtitleLines.map((l) => <span>{l}</span>)}</h2>
          <div class="hero__paras">
            <p class="lead dropcap">{hero.paragraphs[0]}</p>
            <p>{hero.paragraphs[1]}</p>
          </div>
        </div>
        <figure class="plate">
          <span class="plate__c" aria-hidden="true"></span>
          <div class="plate__img" role="img" aria-label="Пейзаж: холмы, река и ветрогенераторы"></div>
          <figcaption class="mono"><span>Рис. 01</span><span>{site.project}</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="sec sec--tint">
    <div class="contours" aria-hidden="true"></div>
    <div class="wrap">
      <div class="sec-mark mono"><span>§ 02</span><span class="dot"></span><span class="line"></span></div>
      <div class="split">
        <h2 class="h2">{initB ? <>{initA} — <em>{initB}</em></> : initiative.title}</h2>
        <div class="split__text">
          <p class="lead">{initiative.paragraphs[0]}</p>
          {initiative.paragraphs.slice(1).map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="docs">
    <div class="wrap">
      <div class="sec-mark mono"><span>§ 03</span><span class="dot"></span><span class="line"></span></div>
      <div class="docs-head">
        <div>
          <h2 class="h2">{research.title}</h2>
          <p class="lead">{research.lead}</p>
        </div>
        <a href={research.allLink.href} class="btn btn--line">{research.allLink.label.replace(/\s*>\s*$/, '')} <span class="arr">→</span></a>
      </div>
      <div class="docs">
        {docs.items.map((d, i) => <DocCover doc={d} index={i} href={`/reviews#${d.id}`} />)}
      </div>
    </div>
  </section>

  <section class="join" id="join">
    <div class="join__bg" aria-hidden="true"></div>
    <div class="contours" aria-hidden="true"></div>
    <div class="wrap">
      <div class="join__in">
        <div>
          <div class="sec-mark mono"><span>§ 04</span><span class="dot"></span><span>{participants.label}</span></div>
          <div class="join__count">{participants.count}</div>
        </div>
        <div>
          <p class="join__text">{participants.text}</p>
          <a href={participants.button.href} class="btn btn--light">{participants.button.label} <span class="arr">→</span></a>
        </div>
      </div>
    </div>
  </section>
</AlmanacLayout>
