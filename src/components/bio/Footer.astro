---
import site from '../../content/site.json';

interface Props { page: keyof typeof site.footer.links }
const f = site.footer;
---
<footer class="ftr">
  <div class="wrap hdr__wrap">
    <div class="ftr__grid">
      <div class="ftr__brand">
        <a href="/" class="ftr__logo" aria-label="Институт развития сельских территорий — на главную">
          <img src="/images/logo-irst.png" alt="Институт развития сельских территорий" width="844" height="345" />
        </a>
        <div class="ftr__rights">{f.rights}</div>
      </div>
    </div>
  </div>
</footer>
<script>
  // Реальная высота подвала — для одноэкранных страниц (слайд + подвал = ровно одно окно)
  const ftr = document.querySelector<HTMLElement>('.ftr');
  if (ftr) new ResizeObserver(() => document.documentElement.style.setProperty('--ftr-h', `${ftr.offsetHeight}px`)).observe(ftr);
</script>
