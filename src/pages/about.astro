---
import BioLayout from '../layouts/BioLayout.astro';
import Terrace from '../components/bio/Terrace.astro';
import about from '../content/about.json';
const { hero, manifesto, methodology, collaboration, tasks, summary, stage1, stage2, participation } = about;
const [step1, step2, step3] = stage2.steps;
const quote = manifesto.blocks.find((b) => b.type === 'quote');
const paras = manifesto.blocks.filter((b) => b.type !== 'quote');
// «Системные вызовы требуют системных решений.» — вторую половину выделяем курсивом
const [heroA, heroB] = hero.title.split(/ (?=требуют)/);
const check = '<svg viewBox="0 0 20 20" width="12" height="12"><path d="M4 10.5 L8 14.5 L16 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>';
---
<BioLayout page="about">
  <!-- 1. Вступление -->
  <section class="hero slide ab-hero">
    <span class="snap snap--top" aria-hidden="true"></span>
    <div class="strata" aria-hidden="true"></div>
    <div class="wrap">
      <h1>{heroB ? <>{heroA}<br /><em class="acc">{heroB}</em></> : hero.title}</h1>
      <div class="hero__stage">
        <div class="hero__photo" role="img" aria-label="Пейзаж: холмы, река и ветрогенераторы"></div>
        <div class="slab"><p class="ab-hero__lead">{hero.lead}</p></div>
      </div>
    </div>
    <div class="slide__terrace"><span class="snap" aria-hidden="true"></span><Terrace fill="#ffffff" /></div>
  </section>

  <!-- 2. Манифест -->
  <section class="sec sec--white slide" id="manifest">
    <div class="wrap">
      <div class="eyebrow">{manifesto.label}</div>
      {quote && <p class="ab-quote">{quote.text}</p>}
      <div class="ab-cols">
        {paras.map((b) => <p>{b.text}</p>)}
      </div>
    </div>
    <div class="slide__terrace"><span class="snap" aria-hidden="true"></span><Terrace fill="#f5f7f2" flip /></div>
  </section>

  <!-- 3. Методология: схема этапов -->
  <section class="sec slide" id="methodology">
    <div class="wrap">
      <div class="eyebrow">{methodology.title}</div>
      <p class="ab-text ab-intro">{methodology.intro}</p>
      <ol class="ab-circles">
        {methodology.stages.map((s) => (
          <li class="ab-circle">
            <span class="ab-circle__num">{s.num}</span>
            <span class="ab-circle__name">{s.name}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="slide__terrace"><span class="snap" aria-hidden="true"></span><Terrace fill="#ffffff" /></div>
  </section>

  <!-- 4. Этапы методологии подробно -->
  <section class="sec sec--white slide" id="methodology-stages">
    <div class="wrap">
      <div class="eyebrow">{methodology.title}</div>
      <div class="ab-stages">
        {methodology.stages.map((s) => (
          <div class="ab-stage">
            <span class="ab-stage__num">{s.num}</span>
            <div>
              <div class="ab-stage__title">{s.title}</div>
              <p class="ab-stage__text">{s.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    <div class="slide__terrace"><span class="snap" aria-hidden="true"></span><Terrace fill="#f5f7f2" flip /></div>
  </section>

  <!-- 5. Совместная работа и краткое содержание документа -->
  <section class="sec slide" id="romashka">
    <div class="wrap">
      <div class="ab-collab">
        <div>
          <div class="eyebrow">{collaboration.label}</div>
          <h2 class="h2" style="margin-top:2vh;">{collaboration.title}</h2>
          <div class="ab-collab__text">
            <p>{collaboration.text}</p>
            <p class="ab-strong">{tasks.title}</p>
            <p>{tasks.text}</p>
          </div>
        </div>
        <div class="ab-sheet">
          <div class="ab-sheet__top"><span class="ab-sheet__mark" aria-hidden="true"></span><span>КБ ВЕКТОР</span></div>
          <div class="ab-sheet__title">{summary.title}</div>
          <ol class="ab-sheet__list">
            {summary.items.map((it) => <li><span>{it.num}</span><span>{it.text}</span></li>)}
          </ol>
        </div>
      </div>
    </div>
    <div class="slide__terrace"><span class="snap" aria-hidden="true"></span><Terrace fill="#ffffff" /></div>
  </section>

  <!-- 6. Этап 1: слева блоки-кнопки, справа общее окно с содержимым выбранного блока -->
  <section class="sec sec--white slide" id="stages">
    <div class="wrap">
      <div class="eyebrow">{about.stagesTitle}</div>
      <h2 class="h2 ab-stagehead">{stage1.title}</h2>
      <div class="ab-tabs" data-tabs>
        <div class="ab-tabs__list" role="tablist" aria-label={stage1.title}>
          <div class="ab-tabs__btns">
            <button class="ab-tab" role="tab" id="s1-t1" aria-controls="s1-p1" aria-selected="true"><b>{stage1.event}</b><span>{stage1.date}</span></button>
            <button class="ab-tab" role="tab" id="s1-t2" aria-controls="s1-p2" aria-selected="false" tabindex="-1"><b>{stage1.start.title}</b></button>
            <button class="ab-tab" role="tab" id="s1-t3" aria-controls="s1-p3" aria-selected="false" tabindex="-1"><b>{stage1.algorithm.title}</b></button>
            <button class="ab-tab" role="tab" id="s1-t4" aria-controls="s1-p4" aria-selected="false" tabindex="-1"><b>{stage1.task.title}</b></button>
          </div>
          <div class="ab-note"><b>{stage1.important.label}</b> {stage1.important.text}</div>
        </div>
        <div class="ab-tabs__panel">
          <div class="ab-panel" role="tabpanel" id="s1-p1" aria-labelledby="s1-t1">
            {stage1.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <div class="ab-panel" role="tabpanel" id="s1-p2" aria-labelledby="s1-t2" hidden>
            {stage1.start.paragraphs.map((p) => <p>{p}</p>)}
          </div>
          <div class="ab-panel" role="tabpanel" id="s1-p3" aria-labelledby="s1-t3" hidden>
            {stage1.algorithm.steps.map((st) => <div class="ab-step"><span>{String(st.num).padStart(2, '0')}</span><p>{st.text}</p></div>)}
          </div>
          <div class="ab-panel" role="tabpanel" id="s1-p4" aria-labelledby="s1-t4" hidden>
            <p>{stage1.task.text}</p>
          </div>
        </div>
      </div>
    </div>
    <div class="slide__terrace"><span class="snap" aria-hidden="true"></span><Terrace fill="#f5f7f2" flip /></div>
  </section>

  <!-- 7. Этап 2: слева блоки-кнопки, справа общее окно (как в этапе 1) -->
  <section class="sec slide slide--pre-dark" id="stage-2">
    <div class="wrap">
      <div class="eyebrow">{about.stagesTitle}</div>
      <h2 class="h2 ab-stagehead">{stage2.titleLines[0]} {stage2.titleLines[1]}</h2>
      <div class="ab-tabs" data-tabs>
        <div class="ab-tabs__list" role="tablist" aria-label={stage2.titleLines.join(' ')}>
          <div class="ab-tabs__btns">
            {[step1, step2, step3].map((st, i) => (
              <button class="ab-tab" role="tab" id={`s2-t${i + 1}`} aria-controls={`s2-p${i + 1}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : '-1'}><b>{st.label}</b><span>{st.title}</span></button>
            ))}
          </div>
          <div class="ab-note"><b>{stage2.important.label}</b> {stage2.important.text}</div>
        </div>
        <div class="ab-tabs__panel">
          <div class="ab-panel" role="tabpanel" id="s2-p1" aria-labelledby="s2-t1">
            <p>{step1.text}</p>
          </div>
          <div class="ab-panel" role="tabpanel" id="s2-p2" aria-labelledby="s2-t2" hidden>
            <p>{step2.text}</p>
            <ul class="ab-dash">{step2.list!.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="ab-panel" role="tabpanel" id="s2-p3" aria-labelledby="s2-t3" hidden>
            <ul class="ab-dash">{step3.list!.map((x) => <li>{x}</li>)}</ul>
            <p>{stage2.after.text}</p>
            <ul class="ab-dash">{stage2.after.list.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Блоки-вкладки: слева кнопки, справа общее окно. Клик/Enter — показать блок; стрелки ↑/↓ — соседний.
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
      const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
      const show = (t: HTMLButtonElement) => {
        tabs.forEach((x) => {
          const on = x === t;
          x.setAttribute('aria-selected', String(on));
          x.tabIndex = on ? 0 : -1;
          document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
        });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => show(t));
        t.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0;
          if (!d) return;
          e.preventDefault(); e.stopPropagation();
          const n = tabs[(i + d + tabs.length) % tabs.length]; show(n); n.focus();
        });
      });
    });
  </script>

  <!-- 8. Открытое участие (+ подвал) -->
  <section class="join slide" id="participation">
    <div class="join__wave"><span class="snap" aria-hidden="true"></span><Terrace fill="#f5f7f2" above /></div>
    <div class="join__body">
      <div class="join__bg" aria-hidden="true"></div>
      <div class="join__glow" aria-hidden="true"></div>
      <div class="strata" aria-hidden="true"></div>
      <div class="wrap">
        <div class="join__in">
          <div class="join__cap ab-part">
            <div>
              <div class="eyebrow">{participation.label}</div>
              <h2 class="ab-part__title">{participation.titleLines[0]}<br /><em class="acc">{participation.titleLines[1]}</em></h2>
              <div class="ab-part__badge"><span></span>{participation.started.title}</div>
              <p class="join__text">{participation.started.text}</p>
              <a href={participation.button.href} class="btn btn--amber">{participation.button.label} <span class="arr">→</span></a>
            </div>
            <div class="ab-part__who">
              <div class="ab-part__whoTitle">{participation.whoTitleLines[0]} {participation.whoTitleLines[1]}</div>
              <p class="ab-part__note">{participation.whoNote}</p>
              <ul class="ab-part__cats">
                {participation.categories.map((c) => (
                  <li><span class="ab-part__check" set:html={check} /><div><b>{c.title}</b><span>{c.text}</span></div></li>
                ))}
              </ul>
              <p class="ab-part__closing"><b>{participation.closingStrong}</b> {participation.closingRest}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BioLayout>
