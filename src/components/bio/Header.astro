---
import site from '../../content/site.json';

interface Props { current: string }
const current = Astro.props.current.replace(/(\.html|\/)$/, '') || '/';
---
<header class="hdr">
  <div class="wrap hdr__wrap">
    <div class="hdr__pill">
      <a href="/" class="hdr__logo" aria-label={site.name}>
        <span class="hdr__mark" aria-hidden="true"></span>
        <span class="hdr__word"><b>КБ</b> ВЕКТОР</span>
      </a>
      <nav class="hdr__nav" aria-label="Основное меню">
        {site.nav.map((item) => (
          <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <a href={site.joinButton.href} class="btn btn--amber" aria-current={current === site.joinButton.href ? 'page' : undefined}>
        {site.joinButton.label}
      </a>
    </div>
  </div>
</header>
