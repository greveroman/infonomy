---
import join from '../../content/join.json';

type Field = (typeof join.fields)[number];
const rows = [...new Set(join.fields.map((f) => f.row))].map((r) => join.fields.filter((f) => f.row === r));

const id = (f: Field) => `f-${f.name}`;
---
<form id="join-form" class="jf" action="/send.php" method="post" novalidate data-error={join.errorMessage}>
  {rows.map((row) => {
    const cells = row.map((f) => (
      <div class="jf__cell" data-f={f.name}>
        <label for={id(f)} class="jf__label">{f.label}{f.required && <span aria-hidden="true"> *</span>}</label>
        {f.hint && <div id={`h-${f.name}`} class="jf__hint">{f.hint}</div>}
        {f.type === 'select' ? (
          <div class="jf__select">
            <select id={id(f)} name={f.name} required={f.required} class="jf__field">
              {f.options!.map((o) => <option value={o}>{o}</option>)}
            </select>
            <svg viewBox="0 0 20 20" width="13" height="13" aria-hidden="true"><path d="M4 7.5 L10 13.5 L16 7.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </div>
        ) : f.type === 'textarea' ? (
          <textarea id={id(f)} name={f.name} rows="3" required={f.required} placeholder={f.placeholder} class="jf__field"></textarea>
        ) : (
          <input id={id(f)} name={f.name} type={f.type} required={f.required} placeholder={f.placeholder} autocomplete={f.autocomplete} aria-describedby={f.hint ? `h-${f.name}` : undefined} class="jf__field" />
        )}
      </div>
    ));
    return row.length > 1
      ? <div class="jf__row">{cells}</div>
      : cells;
  })}

  <!-- Ловушка для спам-ботов: людям не видна -->
  <div style="position:absolute;left:-9999px;" aria-hidden="true">
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" class="btn btn--amber jf__submit">{join.submit}</button>
  <p id="join-error" class="jf__error" role="alert" hidden></p>
</form>

<div id="join-success" class="jf__success" role="status" tabindex="-1" hidden>
  {join.successMessage}
</div>

<script>
  const form = document.getElementById('join-form') as HTMLFormElement;
  const success = document.getElementById('join-success')!;
  const error = document.getElementById('join-error')!;
  const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const fields = Array.from(form.querySelectorAll<HTMLInputElement>('input, select, textarea')).filter((el) => el.name !== 'website');

  const check = (el: HTMLInputElement) => {
    el.value = el.value.trimStart();
    const ok = el.checkValidity();
    el.setAttribute('aria-invalid', String(!ok));
    return ok;
  };
  fields.forEach((el) => el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'blur', () => check(el)));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    error.hidden = true;
    const invalid = fields.filter((el) => !check(el));
    if (invalid.length) {
      invalid[0].focus();
      invalid[0].reportValidity(); // стандартная подсказка браузера на языке пользователя
      return;
    }
    button.disabled = true;
    try {
      const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) throw new Error(data.error || String(res.status));
      form.remove();
      success.hidden = false;
      success.focus();
    } catch {
      error.textContent = form.dataset.error ?? '';
      error.hidden = false;
      button.disabled = false;
    }
  });
</script>
