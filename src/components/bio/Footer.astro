---
import site from '../../content/site.json';

interface Props { page: keyof typeof site.footer.links }
const f = site.footer;
const columns = f.links[Astro.props.page];
---
<footer class="ftr">
  <div class="wrap hdr__wrap">
    <div class="ftr__grid">
      <a href="/" class="ftr__brand" aria-label={site.name}>
        <span class="ftr__mark" aria-hidden="true"></span>
        <span class="ftr__lines">
          <span class="ftr__word">КБ ВЕКТОР</span>
          <span class="ftr__tagline">конструкторское бюро</span>
          <span class="ftr__tagline">{f.tagline.toLowerCase()}</span>
        </span>
      </a>
      {columns.map((col) => (
        <nav aria-label="Навигация в подвале">
          {col.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      ))}
    </div>
    <div class="ftr__bottom"><span class="ftr__rights">{f.rights}</span></div>
  </div>
</footer>
<script>
  // Реальная высота подвала — для одноэкранных страниц (слайд + подвал = ровно одно окно)
  const ftr = document.querySelector<HTMLElement>('.ftr');
  if (ftr) new ResizeObserver(() => document.documentElement.style.setProperty('--ftr-h', `${ftr.offsetHeight}px`)).observe(ftr);
</script>
<script>
  // Подписи — той же ширины, что «КБ ВЕКТОР»
  const fitTagline = () => {
    const word = document.querySelector<HTMLElement>('.ftr__word');
    if (!word) return;
    // сравниваем по видимому краю букв: разрядка добавляет хвост после последнего символа
    const target = word.getBoundingClientRect().width - parseFloat(getComputedStyle(word).letterSpacing);
    document.querySelectorAll<HTMLElement>('.ftr__tagline').forEach((tag) => {
      tag.style.letterSpacing = '0px';
      const n = (tag.textContent ?? '').length;
      for (let k = 0; k < 4; k++) {
        const d = target - (tag.getBoundingClientRect().width - parseFloat(tag.style.letterSpacing));
        if (Math.abs(d) < 0.3) break;
        tag.style.letterSpacing = `${parseFloat(tag.style.letterSpacing) + d / (n - 1)}px`;
      }
    });
  };
  document.fonts.ready.then(fitTagline);
  addEventListener('resize', fitTagline);
</script>
