---
import BioLayout from '../layouts/BioLayout.astro';
import Terrace from '../components/bio/Terrace.astro';
import DocCard from '../components/bio/DocCard.astro';
import reviews from '../content/reviews.json';
import docs from '../content/documents.json';
// «Библиотека опубликованных обзоров и докладов в ходе исследования.» — вторую часть выделяем курсивом
const arrow = (d: string) => `<svg viewBox="0 0 20 20" width="18" height="18"><path d="${d}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const [titleA, titleB] = reviews.title.split(/ (?=обзоров)/);
---
<BioLayout page="reviews">
  <!-- 1. Библиотека: заголовок и карточка с фото -->
  <section class="hero slide ab-hero rv-hero">
    <span class="snap snap--top" aria-hidden="true"></span>
    <div class="strata" aria-hidden="true"></div>
    <div class="wrap">
      <h1>{titleB ? <>{titleA}<br /><em class="acc">{titleB}</em></> : reviews.title}</h1>
      <div class="hero__stage">
        <div class="hero__photo" role="img" aria-label="Пейзаж: холмы, река и ветрогенераторы"></div>
        <div class="slab"><p class="ab-hero__lead">{reviews.lead}</p></div>
      </div>
    </div>
    <div class="slide__terrace"><span class="snap" aria-hidden="true"></span><Terrace fill="#ffffff" /></div>
  </section>

  <!-- 2. Опубликованные документы: листаются слева направо, как эксперты -->
  <section class="sec sec--white slide rv-docs" id="docs">
    <div class="wrap">
      <div class="ex-head">
        <div class="eyebrow">{reviews.docsTitle}</div>
        <div class="ex-nav">
          <button class="ex-btn" data-dir="-1" aria-label="Назад" set:html={arrow('M12.5 4 L6.5 10 L12.5 16')} />
          <button class="ex-btn" data-dir="1" aria-label="Вперёд" set:html={arrow('M7.5 4 L13.5 10 L7.5 16')} />
        </div>
      </div>
      <div class="rv-track" tabindex="0" aria-label={reviews.docsTitle}>
        {docs.items.map((d, i) => <div class="rv-item"><DocCard doc={d} index={i} compact /></div>)}
      </div>
    </div>
    <div class="slide__terrace"><Terrace fill="#0d1812" /></div>
  </section>
  <script>
    // Листание документов по целым карточкам: стрелки, колесо/тачпад (один жест = один шаг), ←/→, свайп.
    const track = document.querySelector<HTMLElement>('.rv-track')!;
    const btns = document.querySelectorAll<HTMLButtonElement>('.rv-docs .ex-btn');
    const items = () => [...track.querySelectorAll<HTMLElement>('.rv-item')];
    let index = 0, lock = 0, lastWheel = 0;
    const perView = () => Math.max(1, Math.round(track.clientWidth / (items()[0].offsetWidth || 1)));
    const maxIndex = () => Math.max(0, items().length - perView());
    const go = (i: number) => {
      index = Math.min(Math.max(i, 0), maxIndex());
      track.scrollTo({ left: items()[index].offsetLeft - items()[0].offsetLeft, behavior: 'smooth' });
      btns[0].disabled = index === 0; btns[1].disabled = index === maxIndex();
    };
    btns.forEach((b) => b.addEventListener('click', () => go(index + Number(b.dataset.dir))));
    track.addEventListener('wheel', (e) => {
      const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      const dir = Math.sign(d);
      if (!dir || (dir < 0 && index === 0) || (dir > 0 && index === maxIndex())) return;
      e.preventDefault();
      const now = performance.now(), gap = now - lastWheel; lastWheel = now;
      if (gap < 250 || now < lock) return;
      lock = now + 450; go(index + dir);
    }, { passive: false });
    track.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') go(index + 1); if (e.key === 'ArrowLeft') go(index - 1); });
    let x0 = 0;
    track.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1)); });
    addEventListener('resize', () => go(index));
    go(0);
  </script>
</BioLayout>
