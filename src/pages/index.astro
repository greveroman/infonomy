---
import BioLayout from '../layouts/BioLayout.astro';
import DocCard from '../components/bio/DocCard.astro';
import Terrace from '../components/bio/Terrace.astro';
import home from '../content/home.json';
import docs from '../content/documents.json';
const { hero, initiative, research, participants } = home;
const last = hero.titleLines.length - 1;
// «… — это …»: вторую часть заголовка выделяем курсивом
const [initA, initB] = initiative.title.split(' — ');
// «Более 100 участников»: число выделяем тёплым цветом
const [countA, countNum, countB] = participants.count.split(/(\d+)/);
---
<BioLayout page="home">
  <section class="hero slide">
    <div class="strata" aria-hidden="true"></div>
    <div class="wrap">
      <h1>{hero.titleLines.map((l, i) => <>{i > 0 && <br />}{i === last ? <em class="acc">{l}</em> : l}</>)}</h1>
      <div class="hero__stage">
        <div class="hero__photo" role="img" aria-label="Пейзаж: холмы, река и ветрогенераторы"></div>
        <div class="slab">
          <h2>{hero.subtitleLines.map((l) => <span>{l}</span>)}</h2>
          <div class="slab__paras">
            <p class="lead">{hero.paragraphs[0]}</p>
            <p>{hero.paragraphs[1]}</p>
          </div>
        </div>
      </div>
    </div>
    <div class="slide__terrace"><Terrace fill="#ffffff" /></div>
  </section>

  <section class="sec sec--white slide" data-snap>
    <div class="slide__top" style="background:#f5f7f2;"><Terrace fill="#ffffff" /></div>
    <div class="wrap">
      <div class="split">
        <div>
          <h2 class="h2">{initB ? <>{initA} — <em class="acc">{initB}</em></> : initiative.title}</h2>
          <div class="woodcap" aria-hidden="true"><div class="woodcap__view"></div><div class="woodcap__plant"></div><div class="woodcap__wood"></div></div>
        </div>
        <div class="split__text">
          <p class="lead">{initiative.paragraphs[0]}</p>
          {initiative.paragraphs.slice(1).map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
    <div class="slide__terrace"><Terrace fill="#f5f7f2" flip /></div>
  </section>

  <section class="sec slide" id="docs" data-snap>
    <div class="slide__top" style="background:#ffffff;"><Terrace fill="#f5f7f2" flip /></div>
    <div class="wrap">
      <div class="docs-head">
        <div>
          <h2 class="h2">{research.title}</h2>
          <p class="lead">{research.lead}</p>
        </div>
        <a href={research.allLink.href} class="btn btn--ghost">{research.allLink.label.replace(/\s*>\s*$/, '')} <span class="arr">→</span></a>
      </div>
      <div class="docs">
        {docs.items.map((d, i) => <DocCard doc={d} index={i} href={`/reviews#${d.id}`} />)}
      </div>
    </div>
    <div class="slide__terrace"><Terrace fill="#f5f7f2" /></div>
  </section>

  <section class="join slide" id="join" data-snap>
    <div class="join__top"><Terrace fill="#0d1812" /></div>
    <div class="join__body">
      <div class="join__bg" aria-hidden="true"></div>
      <div class="join__glow" aria-hidden="true"></div>
      <div class="strata" aria-hidden="true"></div>
      <div class="wrap">
        <div class="join__in">
          <div class="join__cap">
            <div>
              <div class="eyebrow">{participants.label}</div>
              <div class="join__count">{countNum ? <>{countA}<em class="acc">{countNum}</em>{countB}</> : participants.count}</div>
            </div>
            <div>
              <p class="join__text">{participants.text}</p>
              <a href={participants.button.href} class="btn btn--amber">{participants.button.label} <span class="arr">→</span></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BioLayout>
