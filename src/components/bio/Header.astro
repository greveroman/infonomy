---
import site from '../../content/site.json';

interface Props { current: string }
const current = Astro.props.current.replace(/(\.html|\/)$/, '') || '/';
---
<header class="hdr">
  <div class="wrap hdr__wrap">
    <div class="hdr__pill">
      <!-- фон капсулы: высокая «голова» под логотипом плавно переходит в полосу прежней высоты -->
      <span class="hdr__bg" aria-hidden="true">
        <svg class="hdr__head" viewBox="0 0 290 96" width="290" height="96">
          <defs><linearGradient id="hdr-g" x1="0" y1="0" x2="0" y2="96" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#ffffff" /><stop offset=".55" stop-color="#fafcf8" /><stop offset="1" stop-color="#eaf0e7" /></linearGradient></defs>
          <path d="M290,11 L226.6,11 A48,48 0 0 0 196,0 L48,0 A48,48 0 0 0 48,96 L196,96 A48,48 0 0 0 226.6,85 L290,85 Z" fill="url(#hdr-g)" />
          <path d="M290,11.5 L227,11.5 A47.5,47.5 0 0 0 196,.5 L48,.5 A47.5,47.5 0 0 0 48,95.5 L196,95.5 A47.5,47.5 0 0 0 227,84.5 L290,84.5" fill="none" stroke="rgba(210,219,206,0.9)" />
        </svg>
        <span class="hdr__bar"></span>
      </span>
      <a href="/" class="hdr__logo" aria-label="Институт развития сельских территорий — на главную">
        <img class="hdr__full" src="/images/logo-irst-green.png" alt="Институт развития сельских территорий" width="590" height="240" />
      </a>
      <button class="hdr__burger" type="button" aria-label="Меню" aria-expanded="false" aria-controls="hdr-menu"><span></span><span></span><span></span></button>
      <nav class="hdr__nav" id="hdr-menu" aria-label="Основное меню">
        {site.nav.map((item) => (
          <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <a href={site.joinButton.href} class="btn btn--amber" aria-current={current === site.joinButton.href ? 'page' : undefined}>
        {site.joinButton.label}
      </a>
    </div>
  </div>
</header>
<script>
  // Телефон и узкий планшет: меню открывается кнопкой-«бургером» и закрывается по ссылке, Esc или тапу мимо
  const hdr = document.querySelector<HTMLElement>('.hdr');
  const btn = hdr?.querySelector<HTMLButtonElement>('.hdr__burger');
  const set = (open: boolean) => { hdr!.classList.toggle('is-open', open); btn!.setAttribute('aria-expanded', String(open)); };
  btn?.addEventListener('click', () => set(!hdr!.classList.contains('is-open')));
  hdr?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  addEventListener('click', (e) => { if (hdr && !hdr.contains(e.target as Node)) set(false); });
</script>
