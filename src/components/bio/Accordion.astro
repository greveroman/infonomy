---
// Раскрывающийся блок в стиле «Био-модерн».
// group: блоки с одним group — открыт только один (чтобы раскрытый текст помещался в слайд).
interface Props { title: string; subtitle?: string; group?: string; open?: boolean }
const { title, subtitle, group, open = false } = Astro.props;
---
<details class="fold" name={group} open={open}>
  <summary>
    <div class="fold__head">
      <div class="fold__title">{title}</div>
      {subtitle && <div class="fold__sub">{subtitle}</div>}
    </div>
    <span class="fold__chev" aria-hidden="true">
      <svg viewBox="0 0 20 20" width="13" height="13"><path d="M4 7.5 L10 13.5 L16 7.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </span>
  </summary>
  <div class="fold__body"><slot /></div>
</details>
