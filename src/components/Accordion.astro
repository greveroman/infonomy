---
// Раскрывающийся блок (в оригинале — аккордеон этапов работ)
interface Props { title: string; subtitle?: string; gap?: number }
const { title, subtitle, gap = 14 } = Astro.props;
---
<details style="border-radius:16px;background:#fff;box-shadow:inset 0 0 0 1px #e2e6ea,0 18px 40px rgba(28,28,26,0.05);overflow:hidden;">
  <summary class="hv-acc" style="display:flex;align-items:flex-start;justify-content:space-between;gap:24px;padding:24px 26px;cursor:pointer;transition:background .45s cubic-bezier(.33,.72,.4,1);">
    <div style="min-width:0;">
      <div style="font-weight:700;font-size:17px;line-height:1.35;color:#121821;">{title}</div>
      {subtitle && <p style="font-size:15px;line-height:1.6;color:#4a515a;margin-top:10px;">{subtitle}</p>}
    </div>
    <div data-chev style="flex-shrink:0;width:28px;height:28px;border-radius:50%;background:#f3f5f8;display:flex;align-items:center;justify-content:center;margin-top:2px;transition:transform .3s ease;" aria-hidden="true">
      <svg viewBox="0 0 20 20" width="13" height="13"><path d="M4 7.5 L10 13.5 L16 7.5" fill="none" stroke="#1e2530" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </div>
  </summary>
  <div style="padding:0 26px 26px;">
    <div style="height:1px;background:#e9edf2;margin-bottom:20px;"></div>
    <div style={`display:flex;flex-direction:column;gap:${gap}px;font-size:15px;line-height:1.65;color:#4a515a;`}>
      <slot />
    </div>
  </div>
</details>
