---
// Новый шаблон в стиле «Био-модерн». Пока используется только на главной;
// после согласования стиля на него переводятся остальные страницы.
import '../styles/bio.css';
import Header from '../components/bio/Header.astro';
import Footer from '../components/bio/Footer.astro';
import site from '../content/site.json';

interface Props { page: keyof typeof site.seo }
const { page } = Astro.props;
const { title, description } = site.seo[page];
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site).href;
const ogImage = new URL(site.ogImage, Astro.site).href;
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@300..700&family=Literata:ital,opsz,wght@1,7..72,400&display=swap" />
  </head>
  <body>
    <Header current={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer page={page} />
    <script is:inline>
      // Прокрутка по страницам: когда листаешь и останавливаешься, страница мягко доводит до начала следующей
      // (в сторону движения). Назад не тянет — застрять нельзя.
      (() => {
        const mq = matchMedia('(min-width: 1001px)');
        const OFFSET = 0; // страницы начинаются ровно с верха окна
        let lastY = scrollY, dir = 0, timer = 0, auto = false;
        const settle = () => {
          if (!mq.matches) return;
          const zone = innerHeight * 0.95;
          let best = null;
          for (const t of [0, ...[...document.querySelectorAll('[data-snap]')].map((el) => Math.round(el.getBoundingClientRect().top + scrollY - OFFSET))]) {
            const d = t - scrollY;
            if ((dir > 0 && d > 2 && d <= zone) || (dir < 0 && d < -2 && d >= -zone))
              if (!best || Math.abs(d) < Math.abs(best - scrollY)) best = t;
          }
          if (best === null) return;
          auto = true;
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          scrollTo({ top: best, behavior: reduce ? 'auto' : 'smooth' });
          setTimeout(() => { auto = false; lastY = scrollY; }, 700);
        };
        addEventListener('scroll', () => {
          if (auto) return;
          const y = scrollY;
          if (y !== lastY) dir = Math.sign(y - lastY);
          lastY = y;
          clearTimeout(timer);
          timer = setTimeout(settle, 160);
        }, { passive: true });
      })();
    </script>
  </body>
</html>
