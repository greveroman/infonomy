---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocumentCard from '../components/DocumentCard.astro';
import reviews from '../content/reviews.json';
import docs from '../content/documents.json';
---
<BaseLayout page="reviews">
  <section id="library" data-m="wrap" style="max-width:1480px;margin:0 auto;padding:92px;">
    <div data-m="pad" style="border-radius:20px;background:#fff;box-shadow:inset 0 0 0 1px #e2e6ea,0 10px 30px rgba(18,24,33,0.05);padding:clamp(44px,6vw,92px);">
      <h1 style="font-weight:350;font-size:clamp(34px,4.2vw,62px);line-height:1.05;letter-spacing:-0.04em;color:#121821;margin:0;max-width:19em;text-wrap:balance;">{reviews.title}</h1>
      <div style="height:1px;background:#e9edf2;margin:38px 0 34px;max-width:720px;"></div>
      <p style="font-size:18px;line-height:1.7;color:#454c56;max-width:800px;text-wrap:pretty;">{reviews.lead}</p>
    </div>
  </section>

  <section id="docs" data-m="wrap" style="max-width:1480px;margin:0 auto;padding:0 92px 92px;">
    <h2 style="font-weight:400;font-size:clamp(28px,2.6vw,38px);line-height:1.15;letter-spacing:-0.04em;color:#121821;margin:0;">{reviews.docsTitle}</h2>
    <div class="doc-grid" style="margin-top:44px;">
      {docs.items.map((d, i) => <DocumentCard doc={d} index={i} />)}
    </div>
  </section>
</BaseLayout>
