---
// Новый шаблон в стиле «Био-модерн». Пока используется только на главной;
// после согласования стиля на него переводятся остальные страницы.
import '../styles/bio.css';
import Header from '../components/bio/Header.astro';
import Footer from '../components/bio/Footer.astro';
import site from '../content/site.json';

interface Props { page: keyof typeof site.seo }
const { page } = Astro.props;
const { title, description } = site.seo[page];
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site).href;
const ogImage = new URL(site.ogImage, Astro.site).href;
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@300..700&family=Literata:ital,opsz,wght@1,7..72,400&display=swap" />
  </head>
  <body>
    <Header current={Astro.url.pathname} />
    <main>
      <slot />
    </main>
    <Footer page={page} />
    <script is:inline>
      // Листание по страницам (только компьютер): один жест колеса/тачпада = одна страница.
      // Пока идёт перелистывание и докатывается инерция тачпада, новые события игнорируются —
      // поэтому страницы не проскакивают.
      (() => {
        const mq = matchMedia('(min-width: 1001px)');
        let locked = false, lastWheel = 0, startedAt = 0;
        const targets = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          const t = [0, ...[...document.querySelectorAll('[data-snap]')].map((el) => Math.round(el.getBoundingClientRect().top + scrollY)), max];
          return [...new Set(t.map((y) => Math.min(Math.max(y, 0), max)))].sort((a, b) => a - b);
        };
        const go = (dir) => {
          const y = scrollY, list = targets();
          const next = dir > 0 ? list.find((t) => t > y + 4) : [...list].reverse().find((t) => t < y - 4);
          if (next === undefined) return false;
          locked = true; startedAt = performance.now();
          const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          scrollTo({ top: next, behavior: reduce ? 'auto' : 'smooth' });
          const release = () => {
            const now = performance.now();
            if (now - startedAt > 700 && now - lastWheel > 220) locked = false; else setTimeout(release, 60);
          };
          setTimeout(release, 60);
          return true;
        };
        addEventListener('wheel', (e) => {
          if (!mq.matches || e.ctrlKey || Math.abs(e.deltaY) < Math.abs(e.deltaX)) return;
          e.preventDefault();
          lastWheel = performance.now();
          if (locked || Math.abs(e.deltaY) < 2) return;
          go(Math.sign(e.deltaY));
        }, { passive: false });
        addEventListener('keydown', (e) => {
          if (!mq.matches || e.target.closest?.('input,textarea,select,[contenteditable]')) return;
          const dir = { ArrowDown: 1, PageDown: 1, ' ': e.shiftKey ? -1 : 1, ArrowUp: -1, PageUp: -1 }[e.key];
          if (!dir) return;
          e.preventDefault();
          if (!locked) go(dir);
        });
      })();
    </script>
  </body>
</html>
