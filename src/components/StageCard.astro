---
// Нумерованная карточка этапа методологии (01–04)
interface Props { num: string; title: string; text: string }
const { num, title, text } = Astro.props;
---
<div data-m="numcard" style="position:relative;border-radius:16px;background:#fff;box-shadow:inset 0 0 0 1px #e2e6ea,0 18px 40px rgba(28,28,26,0.05);padding:28px 28px 30px 96px;min-height:151px;">
  <div style="position:absolute;left:25px;top:30px;width:44px;height:44px;border-radius:50%;background:#1e2530;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:14px;color:#fff;">{num}</div>
  <div style="font-weight:700;font-size:17px;line-height:1.35;color:#121821;">{title}</div>
  <p style="font-size:15px;line-height:1.6;color:#4a515a;margin-top:11px;">{text}</p>
</div>
