---
import site from '../../content/site.json';

interface Props { page: keyof typeof site.footer.links }
const f = site.footer;
const columns = f.links[Astro.props.page];
---
<footer class="ftr">
  <div class="wrap hdr__wrap">
    <div class="ftr__grid">
      <div class="ftr__brand">
        <a href="/" class="ftr__logo" aria-label={site.name}>
          <span class="ftr__mark" aria-hidden="true"></span>
          <span class="ftr__word">КБ ВЕКТОР</span>
        </a>
        <div class="ftr__tagline">{f.tagline}</div>
      </div>
      {columns.map((col) => (
        <nav aria-label="Навигация в подвале">
          {col.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      ))}
    </div>
    <div class="ftr__bottom"><span class="ftr__rights">{f.rights}</span></div>
  </div>
</footer>
<script>
  // Реальная высота подвала — для одноэкранных страниц (слайд + подвал = ровно одно окно)
  const ftr = document.querySelector<HTMLElement>('.ftr');
  if (ftr) new ResizeObserver(() => document.documentElement.style.setProperty('--ftr-h', `${ftr.offsetHeight}px`)).observe(ftr);
</script>
<script>
  // Подпись под логотипом — той же ширины, что строка «логотип + КБ ВЕКТОР»
  const fitTagline = () => {
    const logo = document.querySelector<HTMLElement>('.ftr__logo');
    const tag = document.querySelector<HTMLElement>('.ftr__tagline');
    if (!logo || !tag) return;
    tag.style.letterSpacing = '0px';
    const n = (tag.textContent ?? '').length;
    const target = logo.getBoundingClientRect().width;
    for (let k = 0; k < 4; k++) {
      const d = target - tag.getBoundingClientRect().width;
      if (Math.abs(d) < 0.3) break;
      tag.style.letterSpacing = `${parseFloat(tag.style.letterSpacing) + d / n}px`;
    }
  };
  document.fonts.ready.then(fitTagline);
  addEventListener('resize', fitTagline);
</script>
