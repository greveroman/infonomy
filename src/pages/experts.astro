---
// Страница «Эксперты»: как «Команда», но ряд кругов листается слева направо (стрелки, колесо, тачпад).
import BioLayout from '../layouts/BioLayout.astro';
import Terrace from '../components/bio/Terrace.astro';
import experts from '../content/experts.json';
const arrow = (d: string) => `<svg viewBox="0 0 20 20" width="18" height="18"><path d="${d}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<BioLayout page="experts">
  <section class="hero slide tm-hero ex-hero">
    <div class="strata" aria-hidden="true"></div>
    <div class="wrap">
      <div class="ex-head">
        <h1>{experts.title} <em class="acc">{experts.titleAccent}</em></h1>
        <div class="ex-nav">
          <button class="ex-btn" data-dir="-1" aria-label="Назад" set:html={arrow('M12.5 4 L6.5 10 L12.5 16')} />
          <button class="ex-btn" data-dir="1" aria-label="Вперёд" set:html={arrow('M7.5 4 L13.5 10 L7.5 16')} />
        </div>
      </div>
      <ul class="tm-grid ex-track" tabindex="0" aria-label="Эксперты">
        {experts.members.map((m) => (
          <li class="tm-person">
            <div class="tm-photo">{m.photo && <img src={m.photo} alt={m.name} loading="lazy" />}</div>
            <div class="tm-name">{m.name}</div>
          </li>
        ))}
      </ul>
    </div>
    <div class="slide__terrace"><Terrace fill="#0d1812" /></div>
  </section>
  <script>
    // Листание по целым кругам: стрелки, колесо/тачпад (один жест = один шаг), клавиши ←/→, свайп.
    const track = document.querySelector<HTMLElement>('.ex-track')!;
    const btns = document.querySelectorAll<HTMLButtonElement>('.ex-btn');
    const items = () => [...track.querySelectorAll<HTMLElement>('.tm-person')];
    let index = 0, lock = 0, lastWheel = 0;
    const perView = () => Math.max(1, Math.round(track.clientWidth / (items()[0].offsetWidth || 1)));
    const maxIndex = () => Math.max(0, items().length - perView());
    const go = (i: number) => {
      index = Math.min(Math.max(i, 0), maxIndex());
      track.scrollTo({ left: items()[index].offsetLeft - items()[0].offsetLeft, behavior: 'smooth' });
      btns[0].disabled = index === 0; btns[1].disabled = index === maxIndex();
    };
    btns.forEach((b) => b.addEventListener('click', () => go(index + Number(b.dataset.dir))));
    track.addEventListener('wheel', (e) => {
      const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      const dir = Math.sign(d);
      if (!dir || (dir < 0 && index === 0) || (dir > 0 && index === maxIndex())) return;
      e.preventDefault();
      const now = performance.now(), gap = now - lastWheel; lastWheel = now;
      if (gap < 250 || now < lock) return; // один жест (вместе с инерцией тачпада) = один шаг
      lock = now + 450; go(index + dir);
    }, { passive: false });
    track.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') go(index + 1); if (e.key === 'ArrowLeft') go(index - 1); });
    let x0 = 0;
    track.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1)); });
    addEventListener('resize', () => go(index));
    go(0);
  </script>
</BioLayout>
